{
  "keyword_wake": {
    "type": "object",
    "description": "关键词唤醒",
    "default": {},
    "items": {
      "keywords": {
        "type": "list",
        "description": "直接唤醒关键词",
        "default": [],
        "hint": "包含任意关键词即唤醒，留空关闭。请勿与 AstrBot 自带唤醒前缀重复配置。"
      },
      "keyword_ignore_case": {
        "type": "bool",
        "description": "关键词不区分大小写",
        "default": true
      }
    }
  },
  "semantic": {
    "type": "object",
    "description": "Jev 语义唤醒",
    "hint": "修改后保存并重载插件生效。",
    "default": {},
    "items": {
      "enabled": {
        "type": "bool",
        "description": "启用 Jev 语义判断",
        "default": true,
        "hint": "仅控制语义判断，不影响关键词、@和引用唤醒。需开启 AstrBot 的“群聊消息记录注入上下文”。"
      },
      "jev_api_url": {
        "type": "string",
        "description": "Jev 请求地址",
        "default": "https://api.typesafe.ai/v1/systemone",
        "condition": {
          "enabled": true
        },
        "hint": "填写兼容 Jev 的完整 HTTP(S) 接口地址，不会自动追加路径。"
      },
      "jev_api_key": {
        "type": "string",
        "description": "TypeSafe AI / Jev API Key",
        "default": "",
        "condition": {
          "enabled": true
        },
        "hint": "留空暂停语义判断。群聊内容会发送到配置的请求地址。"
      },
      "jev_model": {
        "type": "string",
        "description": "Jev 固定模型版本",
        "default": "jev-1.13.0",
        "condition": {
          "enabled": true
        },
        "hint": "填写固定版本号，如 jev-1.13.0，不支持 latest 或 preview。"
      },
      "awake_window_seconds": {
        "type": "float",
        "description": "群共享清醒时长（秒）",
        "default": 180.0,
        "condition": {
          "enabled": true
        },
        "hint": "进入清醒后的持续时间；模型回复成功发送后刷新。"
      },
      "awake_observe_seconds": {
        "type": "float",
        "description": "Jev 消息聚合窗口（秒）",
        "default": 5.0,
        "condition": {
          "enabled": true
        },
        "hint": "从首条待判消息起计时，到期后统一判断；新消息不延长窗口。须大于 0。"
      },
      "max_messages_after_bot": {
        "type": "int",
        "description": "非清醒时距机器人最近发言的最大消息条数",
        "default": 5,
        "condition": {
          "enabled": true
        },
        "minimum": 1,
        "maximum": 1000,
        "hint": "仅检测机器人最近发言后的前几条消息；清醒时不受限制。"
      },
      "history_messages": {
        "type": "int",
        "description": "Jev 历史消息缓存条数",
        "default": 30,
        "condition": {
          "enabled": true
        },
        "minimum": 1,
        "maximum": 1000,
        "hint": "用于 Jev 判断的历史消息条数，不含待判消息；重载后清空。"
      },
      "jev_threshold": {
        "type": "float",
        "description": "逐条语义判断通过阈值",
        "default": 0.75,
        "condition": {
          "enabled": true
        },
        "hint": "大于 0 且不超过 1；值越高，唤醒判断越保守。"
      },
      "jev_timeout_seconds": {
        "type": "float",
        "description": "Jev 单次请求超时（秒）",
        "default": 10.0,
        "condition": {
          "enabled": true
        },
        "hint": "每次请求独立计时，超时后按重试次数处理。"
      },
      "jev_retries": {
        "type": "int",
        "description": "Jev 失败后的重试次数",
        "default": 1,
        "condition": {
          "enabled": true
        },
        "minimum": 0,
        "maximum": 3,
        "hint": "失败后的额外尝试次数，设为 0 不重试。"
      }
    }
  }
}
